# Flask Configuration
FLASK_ENV=production
FLASK_APP=wsgi.py
DEBUG=False

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# TTS Configuration
TTS_BACKEND=pyttsx3
MAX_TEXT_LENGTH=50000
CHUNK_SIZE=500
GAP_MS=150
SPEAKING_RATE=175

# File Configuration
UPLOAD_FOLDER=uploads
DOWNLOADS_FOLDER=downloads

# Deployment
PRODUCTION=True
